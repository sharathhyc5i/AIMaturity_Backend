# ---- Database (your local PostgreSQL) ----
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Local PostgreSQL (see README step 2). For the Azure database, use the DB_* lines below instead.
DATABASE_URL=postgresql+psycopg://retail:retail@localhost:5432/retail_ai

# Azure database (when DB_HOST is set, these are used and DATABASE_URL is ignored).
# Put the real password here only. Never commit this file.
# DB_HOST=ai-maturity-server.postgres.database.azure.com
# DB_PORT=5432
# DB_NAME=ai_maturity
# DB_USER=ai_maturity_admin
# DB_PASSWORD=your-password-here
# DB_SSLMODE=require
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true
DEFAULT_RETAILER=best-buy
DEFAULT_MARKET=US
DEFAULT_PERIOD=2026-11

# ---- Sign-in ----
# local     = no sign-in screen. You are LOCAL_USER_EMAIL, checked against the role rules below.
#             Set LOCAL_USER_EMAIL to a non-admin email (e.g. someone@c5i.ai) to see the user view.
# microsoft = Microsoft SSO via Azure App Service Authentication (/.auth/me). Use on Azure.
AUTH_MODE=local
LOCAL_USER_EMAIL=sharath.hy@course5i.com
LOCAL_USER_NAME=Sharath

ADMIN_EMAILS=sharath.hy@c5i.ai,sharath.hy@course5i.com
ALLOWED_DOMAINS=c5i.ai,course5i.com
